# ============================================================
#  Line ending policy - this file is NOT cosmetic.
#
#  shell scripts MUST stay LF. If Git converts them to CRLF on
#  checkout, bash fails with:  $'\r': command not found
#
#  Windows scripts MUST be CRLF so cmd.exe and PowerShell 5.1
#  parse them correctly.
# ============================================================

# --- default: normalize to LF in the repo ---
* text=auto eol=lf

# --- Windows batch: needs CRLF in the working tree ---
*.cmd  text eol=crlf
*.bat  text eol=crlf

# --- PowerShell: needs CRLF in the working tree ---
*.ps1  text eol=crlf

# --- shell: must stay LF ---
*.sh   text eol=lf
rt     text eol=lf
rt-bootstrap  text eol=lf
*.service     text eol=lf
*.conf        text eol=lf

# --- binary ---
*.png  binary
*.jpg  binary
*.ico  binary
*.exe  binary
*.gz   binary
*.zip  binary
