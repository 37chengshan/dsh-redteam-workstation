# dsh redteam 环境变量 —— dsh web/desktop 启动时加载
# 改完需要重启 dsh 才在本进程生效

# --- FOFA 资产测绘（个人版 10,000 次/月，1 秒 1 次）---
# 获取: https://fofa.info 登录 -> 个人中心 -> API Key
FOFA_KEY=
FOFA_EMAIL=

# --- VPS 反弹 Shell 落地（阿里云 YOUR_VPS_IP）---
REDTEAM_VPS_HOST=YOUR_VPS_IP
REDTEAM_VPS_PORT=22
REDTEAM_VPS_USER=root
# 私钥路径：dsh 会读这个文件；也可直接把私钥放到
#   $DSH_HOME/redteam/toolkit/vps/id_rsa
REDTEAM_VPS_KEY=~/.ssh/id_rsa_vps

# --- 其他 ---
# 跳过 Kali 虚拟机警告
REDTEAM_NO_VM_WARN=1

# --- 载荷分发（安全组只放行了 80/443，所以载荷走 80）---
REDTEAM_PAYLOAD_URL=http://YOUR_VPS_IP
REDTEAM_PAYLOAD_PORT=80
# 反弹 shell 备用端口（443 已放行，可立即用；9000-9999 需在安全组放行）
REDTEAM_SHELL_PORT=443
REDTEAM_SHELL_PORTS=9000-9999
